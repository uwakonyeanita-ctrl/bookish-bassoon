const PLATFORMS = ["Instagram", "TikTok", "YouTube", "LinkedIn", "Facebook"];
const NICHES = Object.keys(IDEAS);

function getIdeas(niche, platform) {
  const nicheData = IDEAS[niche];
  if (!nicheData) return null;
  return nicheData[platform] || nicheData[Object.keys(nicheData)[0]];
}

export default function ContentIdeaGenerator() {
  const [niche, setNiche] = useState("");
  const [platform, setPlatform] = useState("");
  const [ideas, setIdeas] = useState([]);
  const [generated, setGenerated] = useState(false);
  const [error, setError] = useState("");

  const generate = () => {
    if (!niche || !platform) {
      setError("Please select a niche and platform.");
      return;
    }
    setError("");
    const result = getIdeas(niche, platform);
    if (result) {
      const shuffled = [...result].sort(() => Math.random() - 0.5).slice(0, 6);
      setIdeas(shuffled);
    }
    setGenerated(true);
  };

  return (
    <div style={{
      minHeight: "100vh",
      background: "linear-gradient(135deg, #0f0c29, #302b63, #24243e)",
      fontFamily: "'Georgia', serif",
      padding: "2rem 1rem",
      color: "#fff"
    }}>
      <div style={{ maxWidth: 720, margin: "0 auto" }}>

        <div style={{ textAlign: "center", marginBottom: "2.5rem" }}>
          <div style={{
            background: "linear-gradient(90deg, #f7971e, #ffd200)",
            WebkitBackgroundClip: "text",
            WebkitTextFillColor: "transparent",
            fontSize: "2.2rem",
            fontWeight: "bold",
            letterSpacing: "-1px",
          }}>
            💡 Content Idea Generator
          </div>
          <p style={{ color: "#bbb", marginTop: "0.5rem", fontSize: "0.95rem" }}>
            12 niches · 5 platforms · 500+ unique content ideas
          </p>
        </div>

        <div style={{
          background: "rgba(255,255,255,0.06)",
          border: "1px solid rgba(255,255,255,0.12)",
          borderRadius: "20px",
          padding: "2rem",
          marginBottom: "2rem",
        }}>
          <div style={{ marginBottom: "1.5rem" }}>
            <label style={{ display: "block", marginBottom: "0.6rem", color: "#ffd200", fontWeight: "bold", fontSize: "0.85rem", textTransform: "uppercase", letterSpacing: "1px" }}>
              Choose Your Niche
            </label>
            <div style={{ display: "flex", flexWrap: "wrap", gap: "0.5rem" }}>
              {NICHES.map(n => (
                <button key={n} onClick={() => { setNiche(n); setGenerated(false); }} style={{
                  padding: "0.45rem 0.9rem",
                  borderRadius: "30px",
                  border: niche === n ? "2px solid #ffd200" : "1px solid rgba(255,255,255,0.2)",
                  background: niche === n ? "rgba(255,210,0,0.15)" : "rgba(255,255,255,0.05)",
                  color: niche === n ? "#ffd200" : "#ccc",
                  cursor: "pointer",
                  fontSize: "0.82rem",
                  transition: "all 0.2s"
                }}>{n}</button>
              ))}
            </div>
          </div>

          <div style={{ marginBottom: "1.8rem" }}>
            <label style={{ display: "block", marginBottom: "0.6rem", color: "#f7971e", fontWeight: "bold", fontSize: "0.85rem", textTransform: "uppercase", letterSpacing: "1px" }}>
              Choose Your Platform
            </label>
            <div style={{ display: "flex", flexWrap: "wrap", gap: "0.5rem" }}>
              {PLATFORMS.map(p => (
                <button key={p} onClick={() => { setPlatform(p); setGenerated(false); }} style={{
                  padding: "0.45rem 0.9rem",
                  borderRadius: "30px",
                  border: platform === p ? "2px solid #f7971e" : "1px solid rgba(255,255,255,0.2)",
                  background: platform === p ? "rgba(247,151,30,0.15)" : "rgba(255,255,255,0.05)",
                  color: platform === p ? "#f7971e" : "#ccc",
                  cursor: "pointer",
                  fontSize: "0.82rem",
                  transition: "all 0.2s"
                }}>{p}</button>
              ))}
            </div>
          </div>

          {error && <p style={{ color: "#f87171", marginBottom: "1rem", fontSize: "0.9rem" }}>{error}</p>}

          <button onClick={generate} style={{
            width: "100%",
            padding: "0.9rem",
            borderRadius: "14px",
            border: "none",
            background: "linear-gradient(90deg, #f7971e, #ffd200)",
            color: "#000",
            fontWeight: "bold",
            fontSize: "1.05rem",
            cursor: "pointer",
            letterSpacing: "0.5px"
          }}>
            ✨ Generate Content Ideas
          </button>
        </div>

        {generated && ideas.length > 0 && (
          <div>
            <h2 style={{ textAlign: "center", color: "#ffd200", marginBottom: "1.2rem", fontSize: "1rem", letterSpacing: "1px" }}>
              🎯 {niche} ideas for {platform}
            </h2>
            <div style={{ display: "grid", gap: "1rem" }}>
              {ideas.map((idea, i) => (
                <div key={i} style={{
                  background: "rgba(255,255,255,0.06)",
                  border: "1px solid rgba(255,255,255,0.1)",
                  borderRadius: "16px",
                  padding: "1.2rem 1.4rem",
                  transition: "background 0.2s"
                }}
                  onMouseEnter={e => e.currentTarget.style.background = "rgba(255,255,255,0.1)"}
                  onMouseLeave={e => e.currentTarget.style.background = "rgba(255,255,255,0.06)"}
                >
                  <div style={{ display: "flex", alignItems: "flex-start", gap: "0.8rem" }}>
                    <span style={{ fontSize: "1.8rem", flexShrink: 0 }}>{idea.emoji}</span>
                    <div>
                      <div style={{ fontWeight: "bold", fontSize: "1rem", color: "#fff", marginBottom: "0.35rem" }}>
                        {idea.title}
                      </div>
                      <div style={{ color: "#93c5fd", fontSize: "0.87rem", marginBottom: "0.3rem" }}>
                        🎣 <em>{idea.hook}</em>
                      </div>
                      <div style={{ color: "#86efac", fontSize: "0.83rem" }}>
                        💡 {idea.tip}
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
            <div style={{ textAlign: "center", marginTop: "1.5rem" }}>
              <button onClick={generate} style={{
                padding: "0.6rem 1.5rem",
                borderRadius: "30px",
                border: "1px solid #ffd200",
                background: "transparent",
                color: "#ffd200",
                cursor: "pointer",
                fontSize: "0.9rem"
              }}>
                🔄 Shuffle for New Ideas
              </button>
            </div>
          </div>
        )}
      </div>
    </div>
  );
